+    page.getByText("Paid personally", { exact: true }),
+  ).toBeVisible();
+  await expect(page.getByRole("heading", { name: "Your bill" })).toBeVisible();
+  expect(
+    await page.evaluate(
+      () => document.documentElement.scrollWidth <= window.innerWidth,
